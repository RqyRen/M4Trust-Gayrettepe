# M4Trust AI Service - örnek environment (ADR-007 §18-19)
# Gerçek .env dosyası git'e EKLENMEZ. Bu dosya sadece placeholder içerir.

# --- Runtime ---
APP_ENV=local
LOG_LEVEL=INFO
# Railway runtime port'u environment'tan verir; local default aşağıda
AI_API_PORT=8000

# --- RabbitMQ (ADR-002 §5) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/
# TLS/AMQPS (Berke review #6): production'da RABBITMQ_USE_TLS=true VE
# RABBITMQ_USER != guest ZORUNLU (Settings kurulurken fail-fast, app/config.py).
# RABBITMQ_PORT'u da genelde 5671'e (AMQPS) cevirmek gerekir. Bos CA cert
# path sistem trust store'unu kullanir; ozel/self-signed bir CA icin dosya
# yolu ver.
RABBITMQ_USE_TLS=false
RABBITMQ_CA_CERT_PATH=

# --- Object storage (S3-compatible / MinIO, ADR-001 §6) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=changeme
OBJECT_STORAGE_SECRET_KEY=changeme
# SSRF korumasi (Berke review #4): download.url'in kabul edilen hostname'leri,
# virgulle ayrilmis. Bos birakilirsa production disinda kontrol atlanir;
# production'da BOS OLAMAZ (Settings kurulurken fail-fast, app/config.py).
# Production'da ayrica yalniz https kabul edilir ve DNS sonucu private/
# loopback/link-local IP'ye cozunen host'lar (allowlist'te olsa bile)
# reddedilir. Local/staging icin ornek: localhost,127.0.0.1
OBJECT_STORAGE_ALLOWED_HOSTS=

# --- AI provider (ADR-004 §16 — sağlayıcı serbestçe değişebilir) ---
AI_PROVIDER_API_KEY=changeme
