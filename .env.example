# M4Trust AI Service - örnek environment (ADR-007 §18-19)
# Gerçek .env dosyası git'e EKLENMEZ. Bu dosya sadece placeholder içerir.
#
# Bulgu (21 Temmuz 2026): bu dosya gerçek app/config.py::Settings ile
# karşılaştırılıp düzeltildi -- eskiden var olmayan alanlar (OBJECT_STORAGE_
# ENDPOINT/REGION/ACCESS_KEY/SECRET_KEY) listeleniyordu (worker presigned URL
# ile indirir, kendi S3 credential'ı YOKTUR -- ADR-001 §6), Redis ve gerçek
# OPENAI_API_KEY/ROBOFLOW_API_KEY adları hiç yoktu.

# --- Runtime ---
APP_ENV=local
LOG_LEVEL=INFO
# Railway PORT'u kendisi environment'tan verir (ai-api ve ai-worker health
# server'ı ikisi de $PORT'u onurlar); yerelde AI_API_PORT/WORKER_HEALTH_PORT
# fallback'i kullanılır.
AI_API_PORT=8000
WORKER_HEALTH_PORT=8001

# --- RabbitMQ (ADR-002 §5) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/
# TLS/AMQPS: production'da RABBITMQ_USE_TLS=true VE RABBITMQ_USER != guest
# ZORUNLU -- yoksa Settings kurulurken fail-fast olur (app/config.py), servis
# hiç başlamaz. RABBITMQ_PORT'u da genelde 5671'e (AMQPS) çevirmek gerekir.
# Boş CA cert path sistem trust store'unu kullanır; özel/self-signed bir CA
# için dosya yolu ver.
RABBITMQ_USE_TLS=false
RABBITMQ_CA_CERT_PATH=

# --- Redis (job idempotency/lease/cancellation store, ADR-002 §17.1) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Kaynak indirme / SSRF koruması (ADR-001 §6, ADR-002 §7.1) ---
# Worker kendi S3/MinIO credential'ına SAHİP DEĞİLDİR -- yalnızca job
# içindeki kısa ömürlü presigned URL'i indirir. Burada sadece o URL'in
# hostname allowlist'i (virgülle ayrılmış) gerekir.
# Production'da BOŞ OLAMAZ (Settings kurulurken fail-fast) ve yalnız https +
# private/loopback olmayan IP'ye çözünen host kabul edilir. Local için örnek:
# localhost,127.0.0.1
OBJECT_STORAGE_ALLOWED_HOSTS=

# --- LLM: doküman çıkarımı (ADR-004 §16 — sağlayıcı serbestçe değişebilir) ---
OPENAI_API_KEY=changeme
OPENAI_MODEL=gpt-5.4-mini

# --- Video analizi: Roboflow (ADR-004 §16) ---
ROBOFLOW_API_KEY=changeme
