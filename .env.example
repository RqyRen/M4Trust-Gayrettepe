# M4Trust AI Service - örnek environment (ADR-007 §18-19)
# Gerçek .env dosyası git'e EKLENMEZ. Bu dosya sadece placeholder içerir.

# --- Runtime ---
APP_ENV=local
LOG_LEVEL=INFO
# Railway runtime port'u environment'tan verir; local default aşağıda
AI_API_PORT=8000

# --- RabbitMQ (ADR-002 §5) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/

# --- Object storage (S3-compatible / MinIO, ADR-001 §6) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=changeme
OBJECT_STORAGE_SECRET_KEY=changeme

# --- AI provider (ADR-004 §16 — sağlayıcı serbestçe değişebilir) ---
AI_PROVIDER_API_KEY=changeme
